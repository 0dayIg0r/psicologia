# Runtime: use the Supabase transaction pooler for serverless deployments.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require&uselibpqcompat=true&schema=app"

# Migrations: use a direct connection or the Supabase session pooler.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require&uselibpqcompat=true&schema=app"

# Server-only Supabase Auth credentials. Never prefix the service key with NEXT_PUBLIC_.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Legal documents shown during registration.
TERMS_URL="/termos-de-uso"
TERMS_VERSION="2026-01"
PRIVACY_URL="/politica-de-privacidade"
PRIVACY_VERSION="2026-01"

# Optional development-only fixture. Keep disabled outside a development database.
DEV_SEED_ENABLED="false"
DEV_PSYCHOLOGIST_EMAIL=""
DEV_PSYCHOLOGIST_PASSWORD=""
